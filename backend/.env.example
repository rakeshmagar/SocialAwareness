# Backend server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Local MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=social_awareness_db
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_SSL=false

# For TiDB Cloud / production, replace the DB_* values above with the
# connection values shown by TiDB Cloud and set:
# DB_SSL=true
# DB_SSL_REJECT_UNAUTHORIZED=true
# TiDB Cloud commonly uses port 4000; always use the port shown in its console.

# Alternative: some cloud providers give one connection string.
# DATABASE_URL=mysql://username:password@host:port/database

JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d

# Optional admin account created on first startup
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@socialconnect.local
ADMIN_PASSWORD=replace_with_a_strong_admin_password
